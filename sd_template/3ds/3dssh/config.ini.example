# DSSH — SSH connection config (multi-server format)
# Copy this to sd:/3ds/3dssh/config.ini and edit for your servers.
# You can also skip this file entirely: the on-device SETTINGS page
# (SET button, bottom-right of the keyboard) edits and saves this file.

# ── Servers (1..4; the SETTINGS < SRV n/4 > selector switches them) ──

# server1: classic RSA public-key auth
server1_host = your-server.example.com
server1_port = 22
server1_user = ubuntu
server1_auth = key
# Path to your RSA private key on the SD card.  Generate on your PC with
# (-m PEM is REQUIRED — 3DS mbedtls 2.28 cannot parse OpenSSH format):
#   ssh-keygen -t rsa -b 4096 -m PEM -f ~/.ssh/id_rsa_3ds -C "3ds-ssh-client"
server1_key_path = sdmc:/3ds/3dssh/id_rsa
server1_passphrase =

# server2: password auth example (delete if unused)
#server2_host = 192.0.2.10
#server2_port = 22
#server2_user = root
#server2_auth = password
#server2_password = change-me

# Which server to connect to at boot (1-based).
active_server = 1

# ── Voice input ──
# HTTP voice-transcription API (mimo-voice-hub /api/stt or any endpoint
# accepting a WAV POST and answering {"text": "..."}).  When set, START
# recordings upload here instead of the SSH shim.  Leave empty to use
# the classic dssh-whisper-shim over the SSH session.  The on-device
# default can also be baked in at build time:
#   make DSSH_VOICE_API_DEFAULT=https://your-server:29006/api/stt
voice_api_url =

# ── Global (legacy) options ──
# Optional: automatically unlock the current SSH user's macOS login
# keychain.  Quote if it contains # or edge spaces.
# SECURITY WARNING: stored in plaintext on the removable SD card.
macos_keychain_password =

# Optional native Tailscale transport. Setting an auth key enables
# Tailscale; later launches also start automatically when the state file
# exists.
tailscale_auth_key =
tailscale_hostname = dssh-3ds
tailscale_state = sdmc:/3ds/3dssh/tailscale.state
tailscale_control_url = https://controlplane.tailscale.com
